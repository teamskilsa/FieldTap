    <string name="traffic_error_busy">%1$s is already running a test for someone else. Try again when it finishes.</string>
    <string name="traffic_error_refused">Nothing is listening on %1$s:%2$s. Is iperf3 -s running, and is the port open?</string>
    <string name="traffic_error_refused_iperf2">Nothing is listening on %1$s:%2$s. Is iperf -s running there? iperf2 listens on 5001 unless told otherwise.</string>
    <!-- %1$s is the server, %2$s the phone's own address on the bearer. -->
    <string name="traffic_error_iperf2_no_reverse">%1$s accepted the download request but never sent. iperf2 servers older than 2.1 cannot send in reverse — upgrade it, or on the callbox run: iperf -c %2$s</string>
    <string name="traffic_error_iperf2_no_report">The upload went out, but %1$s:%2$s never answered at the end, so there is no loss or jitter. Is iperf -s -u running on that port?</string>
    <string name="traffic_error_no_route">No route to %1$s over cellular. Check the PDN\'s routing on the callbox.</string>
    <string name="traffic_error_timeout">%1$s:%2$s did not answer.</string>
