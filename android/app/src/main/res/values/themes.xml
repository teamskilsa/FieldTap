<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        The window theme only; Compose draws everything inside it (com.fieldtap.ui.FieldTapTheme).
        The window, the Android 12+ splash screen and the first Compose frame share one surface colour,
        so launch has no flash. FieldTap always draws its dark instrument surface, whatever the phone is
        set to, so this is dark here too: values-night only has to repeat it.
    -->
    <style name="Theme.FieldTap" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background_dark</item>
        <item name="android:colorBackground">@color/window_background_dark</item>
        <item name="android:colorPrimary">@color/brand_primary_dark</item>
        <item name="android:colorAccent">@color/brand_primary_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowSplashScreenBackground">@color/window_background_dark</item>
    </style>
</resources>
