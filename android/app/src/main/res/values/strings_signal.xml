<?xml version="1.0" encoding="utf-8"?>
<!--
  The Signal tab: the serving cell, its channel and identity, and the cells around it.

  Its own file because it is its own screen, and the neighbouring files carry naming guards
  (SessionStringsTest, SetupStringsTest) that are about their screens, not this one.
-->
<resources>
    <!-- The four tabs. -->
    <string name="nav_signal">Signal</string>
    <string name="nav_traffic">Traffic</string>
    <string name="nav_logs">Logs</string>
    <string name="sig_title">Signal</string>
    <!-- The age of the serving sample, e.g. "0.4 s". -->
    <string name="sig_age">%1$s s</string>
    <string name="sig_rsrp">RSRP</string>
    <string name="sig_dbm">dBm</string>
    <string name="sig_serving_cell">Serving cell</string>
    <string name="sig_nr_leg">5G NR leg</string>
    <string name="sig_neighbours">Neighbours</string>
    <string name="sig_neighbours_none">No neighbour cells reported.</string>
    <!-- Grid labels. -->
    <string name="sig_pci">PCI</string>
    <string name="sig_earfcn">EARFCN</string>
    <string name="sig_nrarfcn">NR-ARFCN</string>
    <string name="sig_band">Band</string>
    <string name="sig_dl">Downlink</string>
    <string name="sig_ul">Uplink</string>
    <string name="sig_enb">eNB</string>
    <string name="sig_cell">Cell</string>
    <string name="sig_tac">TAC</string>
    <string name="sig_eci">ECI</string>
    <string name="sig_bandwidth">Bandwidth</string>
    <string name="sig_rssi">RSSI</string>
