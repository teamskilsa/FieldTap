    <string name="sig_location_needed_title">Needs precise location</string>
    <string name="sig_location_needed">Android hides cell identity from apps without precise location.</string>
    <string name="sig_location_allow">Allow</string>
    <string name="sig_location_off_title">Location is off</string>
    <string name="sig_location_off">Android returns no cell information while location is off.</string>
    <string name="sig_location_turn_on">Turn on</string>
